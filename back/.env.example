# ===== Backend Configuration =====

# Port serveur HTTP
PORT=3000

# Secret JWT pour signer les tokens
# Générer un secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me_please

# Mot de passe admin initial (utilisé UNIQUEMENT au premier lancement pour créer le hash bcrypt)
# Après le premier lancement, le hash est stocké dans back/data/passuser.json
MAIN_PASS=change_me_please